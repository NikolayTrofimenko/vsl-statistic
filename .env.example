# First admin account, created at startup while there is no admin. Other
# accounts are created by the admin on the "Пользователи" page.
VSL_STAT_ADMIN_LOGIN=admin
VSL_STAT_ADMIN_PASSWORD=change-me-please

# Key used to encrypt the stored Google refresh token and sign sessions.
# If unset, a random key is generated once at $VSL_STAT_DATA/.secret-key.
VSL_STAT_SECRET=

# SQLite database, thumbnails cache and logs live here.
VSL_STAT_DATA=./data

# Set to 1 when served over plain HTTP (local dev), so the session cookie is stored.
VSL_STAT_INSECURE_COOKIES=1

PORT=4310
VSL_STAT_LOG_LEVEL=info

# --- Google Drive (OAuth "Web application" client, console.cloud.google.com) ---
# Authorized redirect URI must be exactly <VSL_STAT_PUBLIC_URL>/api/drive/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Root folder of the video library.
DRIVE_FOLDER_ID=10Yqr7NQl_7voOPyD2m9izWCMHYohrJtN

# Public URL of this service: used for the OAuth redirect and the tracker snippet.
# In dev with `npm run dev` that is the Angular dev server.
VSL_STAT_PUBLIC_URL=http://127.0.0.1:4200

# craft-lander video catalog (videos.json), read-only — names for landing streams.
# In production it is mounted from craft-lander's data volume.
CRAFT_VIDEOS_FILE=

# Keitaro Admin API (caps: daily leads per offer). Same tracker and key as craft-lander.
KEITARO_URL=
KEITARO_API_KEY=

# Kaiten (dashboard: hiring boards). Token of a read-only user that sees the boards.
KAITEN_URL=https://euphoria.kaiten.ru
KAITEN_TOKEN=

# Namecheap API (domains). Works only from a whitelisted IP — the server's.
NAMECHEAP_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=

# Cloudflare (domains' DNS). Token with Zone: Edit + DNS: Edit on the account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# IP working subdomains point to; defaults to KEITARO_URL's host.
KEITARO_DOMAIN_IP=

# Telegram alerts (caps). Same bot as spendbridge; the chat is the team group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

{
  "name": "vsl-statistic",
  "version": "0.1.0",
  "private": true,
  "description": "VSL video library (Google Drive) and watch-time analytics for landing pages.",
  "main": "dist-server/server/index.js",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "build": "npm run build:renderer && npm run build:server",
    "build:renderer": "ng build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "concurrently -k -n NG,TSC,SRV -c blue,yellow,green \"npm:dev:renderer\" \"npm:dev:build\" \"npm:dev:server\"",
    "dev:renderer": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "dev:build": "tsc -p tsconfig.server.json --watch --preserveWatchOutput",
    "dev:server": "node --watch --env-file-if-exists=.env dist-server/server/index.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@angular/build": "20.3.26",
    "@angular/cli": "20.3.26",
    "@angular/compiler-cli": "20.3.21",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "2.16.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@angular/animations": "20.3.21",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.21",
    "@angular/compiler": "20.3.21",
    "@angular/core": "20.3.21",
    "@angular/forms": "20.3.21",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.21",
    "@angular/router": "20.3.21",
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "express": "^5.2.1",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "sanitize-html": "2.18.1",
    "tslib": "^2.3.0",
    "undici": "^7.30.0",
    "zod": "^4.0.0",
    "zone.js": "~0.15.0"
  }
}
